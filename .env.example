# ----------------------------
# App
# ----------------------------
APP_ENV=local
APP_PORT=8080

# ----------------------------
# Application DB connection (Go app, migrations, tools)
# ----------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=conmesh_dev
DB_SSLMODE=disable

DB_URL=postgres://postgres:postgres@postgres:5432/conmesh_dev?sslmode=disable

# ----------------------------
# Postgres container init (Docker image uses these on first init)
# ----------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=conmesh_dev
